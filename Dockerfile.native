## Stage 1: Build with Maven
FROM dhi.io/maven:3-jdk21-alpine3.22-dev AS maven-builder

WORKDIR /build

# Copiar archivos de configuración
COPY pom.xml .

# Descargar dependencias
RUN mvn dependency:go-offline

# Copiar código fuente
COPY src src

# Compilar aplicación (generar clases)
RUN mvn clean package -DskipTests

## Stage 2: Build Native Binary
FROM quay.io/quarkus/ubi-quarkus-mandrel-builder-image:23.1-java21 AS native-builder

USER root

# Instalar Maven
RUN microdnf install -y wget tar gzip && \
    wget https://archive.apache.org/dist/maven/maven-3/3.9.5/binaries/apache-maven-3.9.5-bin.tar.gz && \
    tar xzf apache-maven-3.9.5-bin.tar.gz -C /opt && \
    ln -s /opt/apache-maven-3.9.5 /opt/maven && \
    rm apache-maven-3.9.5-bin.tar.gz && \
    microdnf clean all

ENV PATH="/opt/maven/bin:${PATH}"

USER quarkus
WORKDIR /code

# Copiar pom.xml y src
COPY --chown=quarkus:quarkus pom.xml .
COPY --chown=quarkus:quarkus src src

# Copiar las dependencias ya descargadas
COPY --chown=quarkus:quarkus --from=maven-builder /root/.m2 /home/quarkus/.m2

# Compilar en modo nativo
RUN mvn package -Pnative -DskipTests

## Stage 2: Runtime Minimal
FROM quay.io/quarkus/quarkus-micro-image:2.0

WORKDIR /work/

# Copiar binario nativo
COPY --from=native-builder /code/target/*-runner /work/application

# Dar permisos de ejecución
RUN chmod 775 /work/application

EXPOSE 8080

# Usuario no privilegiado
USER 1001

# Metadata
LABEL maintainer="workshop@example.com" \
    description="Quarkus Hello API (Native) for Azure Workshop" \
    version="1.0.0"

# Punto de entrada
CMD ["./application", "-Dquarkus.http.host=0.0.0.0"]
